{
  "private": true,
  "name": "changelog-writer",
  "version": "1.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kleshzz/changelog-writer.git"
  },
  "bugs": {
    "url": "https://github.com/Kleshzz/changelog-writer/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && ts-node tests/action.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "esbuild": "^0.28.0",
    "eslint": "^10",
    "prettier": "^3",
    "ts-node": "^10.9.2",
    "typescript": "^6"
  }
}
